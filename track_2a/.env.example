# Copy to .env and fill in. .env is git-ignored and never enters the image.
# Official names (the organisers inject these at evaluation):
BASE_URL=https://api.inference.cscs.ch/v1
API_KEY=your-api-key
# Optional; defaults to swiss-ai/Apertus-v1.5-8B:
MODEL=swiss-ai/Apertus-v1.5-8B
# Older local names, used only when the official ones are not set:
# LLM_BASE_URL=...
# LLM_API_KEY=...
# LLM_NAME=...
